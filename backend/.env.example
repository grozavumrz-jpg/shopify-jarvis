# Copy to backend/.env for local runs. Never commit real values.
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_client_secret
SHOP_DOMAIN=grozavushop.myshopify.com
# Optional: Admin API token (custom app). Lets Jarvis reconnect itself after restarts.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# auto = client credentials when API key+secret are set (Dev Dashboard app); oauth = classic install flow only
SHOPIFY_AUTH_MODE=auto
# Public URL of this app (Render sets RENDER_EXTERNAL_URL automatically)
APP_URL=https://shopify-jarvis.onrender.com
# Persistent Postgres (Neon / Supabase / Render Postgres). Empty = local SQLite (data lost on Render restarts!)
DATABASE_URL=
JARVIS_SQLITE_PATH=
# Dashboard password when opened outside Shopify admin (min 12 characters)
JARVIS_ADMIN_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
RESEND_API_KEY=
SENDER_EMAIL=Grozavu <contact@maisongrozavu.com>
REPLY_TO_EMAIL=info@maisongrozavu.com
MERCHANT_NOTIFY_EMAIL=
BRAND_NAME=Grozavu
FEED_DOMAIN=maisongrozavu.com
